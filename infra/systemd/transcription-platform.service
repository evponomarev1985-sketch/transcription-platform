[Unit]
Description=Transcription Platform Docker Compose Stack
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/evponomarev1985/transcription-platform
EnvironmentFile=/etc/default/transcription-platform
ExecStartPre=/home/evponomarev1985/transcription-platform/infra/scripts/refresh_env_from_lockbox.sh
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
