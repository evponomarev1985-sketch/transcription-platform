AUTH_DATABASE_URL=postgresql+psycopg://auth_user:auth_password@host:5432/auth_db
CALLS_DATABASE_URL=postgresql+psycopg://calls_user:calls_password@host:5432/calls_db
AUTH_DB_AUTO_CREATE=false
CALLS_DB_AUTO_CREATE=false
JWT_SECRET=replace_me
AUTH_REGISTRATION_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_LOGIN=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=replace_me

UPLOAD_SIGNING_SECRET=replace_me

YC_S3_ENDPOINT=https://storage.yandexcloud.net
YC_S3_REGION=ru-central1
YC_S3_BUCKET=replace-me
YC_ACCESS_KEY_ID=replace_me
YC_SECRET_ACCESS_KEY=replace_me

YMQ_ENDPOINT_URL=https://message-queue.api.cloud.yandex.net
YMQ_QUEUE_URL=replace_me
YMQ_REGION=ru-central1
YMQ_ACCESS_KEY_ID=replace_me
YMQ_SECRET_ACCESS_KEY=replace_me

CALL_SERVICE_INTERNAL_API_KEY=replace_me

YC_IAM_TOKEN_SOURCE=auto
# Use only if YC_IAM_TOKEN_SOURCE=env
YC_IAM_TOKEN=
YC_METADATA_TOKEN_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
YC_METADATA_TIMEOUT_SECONDS=5
YC_METADATA_REFRESH_MARGIN_SECONDS=120
YANDEXGPT_FOLDER_ID=replace_me
# Optional: override full model URI (if empty, built from YANDEXGPT_FOLDER_ID)
YANDEXGPT_MODEL_URI=
YANDEXGPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
SPEECHKIT_API_VERSION=v3
SPEECHKIT_FOLDER_ID=replace_me
SPEECHKIT_LONG_RUNNING_URL=https://transcribe.api.cloud.yandex.net/speech/stt/v2/longRunningRecognize
SPEECHKIT_V3_RECOGNIZE_FILE_ASYNC_URL=https://stt.api.cloud.yandex.net/stt/v3/recognizeFileAsync
SPEECHKIT_V3_GET_RECOGNITION_URL=https://stt.api.cloud.yandex.net/stt/v3/getRecognition
SPEECHKIT_OPERATION_URL=https://operation.api.cloud.yandex.net/operations
SPEECHKIT_MODEL=general
SPEECHKIT_LANGUAGE=ru-RU
SPEECHKIT_AUDIO_CHANNEL_COUNT=1
# Note: For MP3/OggOpus, SpeechKit detects channel count from file metadata.
# audioChannelCount should be forced only for LPCM/RAW inputs.
SPEECHKIT_RAW_RESULTS=true
SPEECHKIT_TEXT_NORMALIZATION_ENABLED=true
SPEECHKIT_LITERATURE_TEXT=false
SPEECHKIT_PROFANITY_FILTER=false
SPEECHKIT_SPEAKER_LABELING_ENABLED=true
SPEECHKIT_SUMMARIZATION_ENABLED=true
SPEECHKIT_SUMMARIZATION_MODEL_URI=gpt://<folder_id>/yandexgpt-lite/latest
