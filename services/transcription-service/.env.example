APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8004
INTERNAL_API_KEY=replace_me
CALL_SERVICE_INTERNAL_URL=http://call-service:8003
YMQ_ENDPOINT_URL=https://message-queue.api.cloud.yandex.net
YMQ_QUEUE_URL=replace_me
YMQ_REGION=ru-central1
YMQ_ACCESS_KEY_ID=replace_me
YMQ_SECRET_ACCESS_KEY=replace_me
YC_IAM_TOKEN_SOURCE=auto
# Use only if YC_IAM_TOKEN_SOURCE=env
YC_IAM_TOKEN=
YC_METADATA_TOKEN_URL=http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token
YC_METADATA_TIMEOUT_SECONDS=5
YC_METADATA_REFRESH_MARGIN_SECONDS=120
SPEECHKIT_LONG_RUNNING_URL=https://transcribe.api.cloud.yandex.net/speech/stt/v2/longRunningRecognize
SPEECHKIT_OPERATION_URL=https://operation.api.cloud.yandex.net/operations
SPEECHKIT_MODEL=general
SPEECHKIT_LANGUAGE=ru-RU
SPEECHKIT_AUDIO_CHANNEL_COUNT=1
SPEECHKIT_POLL_DELAY_SECONDS=15
SPEECHKIT_MAX_ATTEMPTS=200
